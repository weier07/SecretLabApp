ScreenManager:
    LoginScreen:
        name: 'login'

    RegisterScreen:
        name: 'register'

    MainMenuScreen:
        name: 'menu'

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 30
        spacing: 15

        Label:
            text: 'СЕКРЕТНАЯ ЛАБОРАТОРИЯ'
            font_size: 24

        Label:
            text: 'Авторизация'

        TextInput:
            id: login_input
            hint_text: 'Введите логин'
            multiline: False
            size_hint_y: 0.15

        TextInput:
            id: password_input
            hint_text: 'Введите пароль'
            password: True
            multiline: False
            size_hint_y: 0.15

        Button:
            text: 'Войти'
            size_hint_y: 0.15
            on_release: root.login_user()

        Label:
            id: message
            text: ''

        Button:
            text: 'Регистрация'
            size_hint_y: 0.15
            on_release: root.manager.current = 'register'

<RegisterScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 30
        spacing: 15

        Label:
            text: 'Регистрация'
            bold: True
            font_size: 24

        TextInput:
            id: reg_login
            hint_text: 'Придумайте логин'
            multiline: False
            size_hint_y: 0.15

        TextInput:
            id: reg_password
            hint_text: 'Придумайте пароль'
            password: True
            multiline: False
            size_hint_y: 0.15

        Button:
            text: 'Зарегистрироваться'
            size_hint_y: 0.15
            on_release: root.register_user()

        Label:
            id: reg_message
            text: ''

        Button:
            text: 'Назад'
            size_hint_y: 0.15
            on_release: root.manager.current = 'login'

<MainMenuScreen>:
    FloatLayout:
        Image:
            source: 'background.jpg'
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {'x': 0, 'y': 0}

        Label:
            text: 'СЕКРЕТНАЯ ЛАБОРАТОРИЯ'
            font_size: 26
            bold: True
            size_hint: 1, 0.15
            pos_hint: {'center_x': 0.5, 'top': 0.95}

        GridLayout:
            cols: 2
            rows: 2
            spacing: 15
            padding: 20
            size_hint: 0.85, 0.4
            pos_hint: {'center_x': 0.5, 'center_y': 0.58}

            Button:
                text: 'Приветствие агента'
                on_release: root.greet_agent()

            Button:
                text: 'Информация об агенте'
                on_release: root.show_agent_info()

            Button:
                text: 'Секретное задание'
                on_release: root.show_secret_mission()

            Button:
                text: 'Проверка доступа'
                on_release: root.check_access()

        Label:
            id: info_label
            text: 'Выберите действие...'
            font_size: 18
            halign: 'center'
            size_hint: 0.9, 0.15
            pos_hint: {'center_x': 0.5, 'y': 0.16}

        Button:
            text: 'Выйти'
            size_hint: 0.3, 0.08
            pos_hint: {'center_x': 0.5, 'y': 0.05}
            on_release: root.manager.current = 'login'




